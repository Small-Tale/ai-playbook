.hotsheet2/store
.hotsheet2/settings.local.json

# Hot Sheet checkout-local files (HS2-W3RAMK). Only `.hotsheet2/settings.json`, the
# push-policy declaration that setup renders into AGENTS.md, is tracked. `.hotsheet/`
# is the HS1 runtime directory (mcp.log, channel-ports.d).
/.hotsheet2/*
!/.hotsheet2/settings.json
/.hotsheet/

# Generated Hot Sheet tool configs; they embed this machine's absolute paths.
/.mcp.json
/.claude/settings.local.json
/.codex/config.toml
/.codex/hooks.json
/.agents/mcp_config.json
/opencode.json

# Python bytecode written by the unit-test gate (HS2-9NE1WE).
__pycache__/
